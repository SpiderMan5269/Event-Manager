<%- include('partials/header', { title: event.title + " - Event Details" }) %>

  <main class="max-w-4xl mx-auto py-8 px-4">
    <!-- Back button -->
    <div class="mb-6">
      <a href="/organiser" class="text-indigo-600 hover:underline text-sm font-medium">← Back to Organiser Home</a>
    </div>

    <!-- Event Header -->
    <section class="bg-white rounded-lg shadow-md p-8 mb-6">
      <h1 class="text-4xl font-bold text-gray-900 mb-2"><%= event.title %></h1>
      <p class="text-lg text-gray-600 mb-4"><%= event.description %></p>
      
      <div class="grid grid-cols-2 gap-4 text-sm mb-4">
        <div>
          <p class="font-semibold text-gray-700">Event Date</p>
          <p class="text-gray-600"><%= event.event_date_formatted %></p>
        </div>
        <div>
          <p class="font-semibold text-gray-700">Status</p>
          <span class="inline-block px-3 py-1 rounded-full text-white text-sm font-medium <%= event.status === 'published' ? 'bg-green-500' : 'bg-yellow-500' %>">
            <%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %>
          </span>
        </div>
      </div>
    </section>

    <!-- Ticket Information -->
    <section class="bg-white rounded-lg shadow-md p-8 mb-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Ticket Information</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Full Price Tickets -->
        <% if (ticketStats.full) { %>
          <div class="border border-gray-200 rounded-lg p-4">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">Full Price Tickets</h3>
            <dl class="space-y-2 text-sm">
              <div class="flex justify-between">
                <dt class="text-gray-600">Price:</dt>
                <dd class="font-medium">£<%= ticketStats.full.price || '0.00' %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-600">Total Quantity:</dt>
                <dd class="font-medium"><%= ticketStats.full.total_quantity || 0 %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-600">Remaining:</dt>
                <dd class="font-medium text-indigo-600"><%= ticketStats.full.remaining_quantity || 0 %></dd>
              </div>
              <div class="flex justify-between pt-2 border-t border-gray-200">
                <dt class="text-gray-600">Sold:</dt>
                <dd class="font-medium text-green-600"><%= (ticketStats.full.total_quantity || 0) - (ticketStats.full.remaining_quantity || 0) %></dd>
              </div>
            </dl>
          </div>
        <% } %>

        <!-- Concession Tickets -->
        <% if (ticketStats.concession) { %>
          <div class="border border-gray-200 rounded-lg p-4">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">Concession Tickets</h3>
            <dl class="space-y-2 text-sm">
              <div class="flex justify-between">
                <dt class="text-gray-600">Price:</dt>
                <dd class="font-medium">£<%= ticketStats.concession.price || '0.00' %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-600">Total Quantity:</dt>
                <dd class="font-medium"><%= ticketStats.concession.total_quantity || 0 %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-600">Remaining:</dt>
                <dd class="font-medium text-indigo-600"><%= ticketStats.concession.remaining_quantity || 0 %></dd>
              </div>
              <div class="flex justify-between pt-2 border-t border-gray-200">
                <dt class="text-gray-600">Sold:</dt>
                <dd class="font-medium text-green-600"><%= (ticketStats.concession.total_quantity || 0) - (ticketStats.concession.remaining_quantity || 0) %></dd>
              </div>
            </dl>
          </div>
        <% } %>
      </div>

      <!-- Summary Stats -->
      <div class="mt-6 pt-6 border-t border-gray-200">
        <div class="grid grid-cols-3 gap-4 text-center">
          <div>
            <p class="text-gray-600 text-sm">Total Capacity</p>
            <p class="text-2xl font-bold text-gray-900"><%= (ticketStats.full.total_quantity || 0) + (ticketStats.concession.total_quantity || 0) %></p>
          </div>
          <div>
            <p class="text-gray-600 text-sm">Tickets Sold</p>
            <p class="text-2xl font-bold text-green-600"><%= totalTicketsSold %></p>
          </div>
          <div>
            <p class="text-gray-600 text-sm">Availability</p>
            <p class="text-2xl font-bold text-indigo-600"><%= (ticketStats.full.remaining_quantity || 0) + (ticketStats.concession.remaining_quantity || 0) %></p>
          </div>
        </div>
      </div>
    </section>

    <!-- Bookings List -->
    <section class="bg-white rounded-lg shadow-md p-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Bookings (<%= bookings.length %>)</h2>
      
      <% if (bookings && bookings.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="border-b-2 border-gray-300 bg-gray-50">
              <tr>
                <th class="text-left py-2 px-4 font-semibold text-gray-700">Attendee Name</th>
                <th class="text-center py-2 px-4 font-semibold text-gray-700">Full Price</th>
                <th class="text-center py-2 px-4 font-semibold text-gray-700">Concession</th>
                <th class="text-center py-2 px-4 font-semibold text-gray-700">Total Tickets</th>
                <th class="text-right py-2 px-4 font-semibold text-gray-700">Booking Date</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% bookings.forEach(booking => {
                const bookingDate = new Date(booking.booked_at);
                const formattedDate = bookingDate.toLocaleDateString('en-GB', { 
                  year: 'numeric', 
                  month: 'short', 
                  day: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit'
                });
              %>
                <tr class="hover:bg-gray-50">
                  <td class="py-3 px-4 text-gray-900"><%= booking.attendee_name || 'N/A' %></td>
                  <td class="text-center py-3 px-4 text-gray-600"><%= booking.full_tickets || 0 %></td>
                  <td class="text-center py-3 px-4 text-gray-600"><%= booking.concession_tickets || 0 %></td>
                  <td class="text-center py-3 px-4 font-semibold text-gray-900"><%= (booking.full_tickets || 0) + (booking.concession_tickets || 0) %></td>
                  <td class="text-right py-3 px-4 text-gray-600 text-xs"><%= formattedDate %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="text-gray-600 text-center py-8">No bookings yet for this event.</p>
      <% } %>
    </section>

    <!-- Action Buttons -->
    <div class="mt-8 space-x-3 flex">
      <a href="/organiser/events/<%= event.id %>/edit" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2 rounded font-medium text-sm">
        Edit Event
      </a>
      <a href="/organiser" class="inline-block bg-gray-300 hover:bg-gray-400 text-gray-800 px-6 py-2 rounded font-medium text-sm">
        Back
      </a>
    </div>
  </main>

  <%- include('partials/footer') %>

