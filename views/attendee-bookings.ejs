<%- include("partials/header", { title: "My Bookings" }) %>

<main id="main-content" class="container mx-auto p-6">
  <div class="mb-6">
    <a href="/attendee" class="text-indigo-600 hover:underline text-sm font-medium">← Back to Events</a>
  </div>

  <h1 class="text-2xl font-bold mb-4">My Bookings</h1>

  <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    <div class="bg-green-50 border border-green-200 p-4 mb-4 rounded" role="alert">
      <p class="text-green-700 font-medium"><%= successMessage %></p>
    </div>
  <% } %>

  <% if (!bookings || bookings.length === 0) { %>
    <p class="text-gray-600 mb-6">You haven't booked any events yet.</p>
    <a href="/attendee" class="text-indigo-600 hover:underline">Browse Available Events</a>
  <% } else { %>
    <div class="space-y-4">
      <% bookings.forEach(b => { %>
        <div class="bg-white rounded shadow-sm p-4 border-l-4 border-indigo-600">
          <div class="flex justify-between items-start mb-3">
            <div>
              <h3 class="text-lg font-semibold"><a class="text-indigo-600 hover:underline" href="/attendee/events/<%= b.event_id %>"><%= b.title %></a></h3>
              <p class="text-sm text-gray-500">Date: <%= b.event_date %></p>
            </div>
            <div class="text-sm text-gray-500">Booked: <%= b.booked_at %></div>
          </div>
          <div class="space-y-1 text-sm mb-3">
            <p class="text-gray-700">Attendee Name: <span class="font-medium"><%= b.attendee_name %></span></p>
            <% if (b.full_tickets > 0) { %>
              <p class="text-gray-700">Full Tickets: <span class="font-medium"><%= b.full_tickets %></span></p>
            <% } %>
            <% if (b.concession_tickets > 0) { %>
              <p class="text-gray-700">Concession Tickets: <span class="font-medium"><%= b.concession_tickets %></span></p>
            <% } %>
          </div>
          <div class="flex justify-end">
            <form method="POST" action="/attendee/bookings/<%= b.id %>/cancel" style="display:inline">
              <button type="submit" class="text-sm text-red-600 hover:text-red-800 font-medium" onclick="return confirm('Are you sure you want to cancel this booking?');">Cancel Booking</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include("partials/footer") %>
