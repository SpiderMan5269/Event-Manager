<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || "Event Manager" %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-900 h-full flex flex-col">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-white p-2 rounded">Skip to content</a>
  <header role="banner" class="bg-indigo-600 text-white shadow-lg">
    <div class="container mx-auto px-6 py-6 flex items-center justify-between">
      <a href="/" class="text-3xl font-bold hover:text-indigo-200 transition" aria-label="Event Manager Home">Event Manager</a>
      <nav role="navigation" aria-label="Primary" class="space-x-8 text-lg flex items-center">
        <a href="/" class="text-white hover:text-indigo-200 transition font-medium">Home</a>
        <% if (typeof req !== 'undefined' && req.session && req.session.user) { %>
          <% if (req.session.user.role === 'organiser') { %>
            <a href="/organiser" class="text-white hover:text-indigo-200 transition font-medium" aria-label="Organiser Home">Organiser</a>
          <% } %>
          <a href="/attendee" class="text-white hover:text-indigo-200 transition font-medium" aria-label="Attendee Home">Attendee</a>
          <a href="/attendee/my-bookings" class="text-white hover:text-indigo-200 transition font-medium">My Bookings</a>
          <a href="/profile" class="text-white hover:text-indigo-200 transition font-medium">Profile</a>
          <span class="text-sm bg-indigo-700 px-3 py-1 rounded"><%= req.session.user.user_name %></span>
          <a href="/auth/logout" class="text-white hover:text-indigo-200 transition font-medium">Logout</a>
        <% } else { %>
          <a href="/auth/login" class="text-white hover:text-indigo-200 transition font-medium">Login</a>
          <a href="/users/add-user" class="text-white hover:text-indigo-200 transition font-medium">Register</a>
        <% } %>
      </nav>
    </div>
  </header>
