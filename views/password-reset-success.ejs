<%- include("partials/header", { title: "Password Reset" }) %>

  <main id="main-content" class="container mx-auto p-6 max-w-md">
    <div class="bg-white rounded shadow-md p-6">
      <h1 class="text-2xl font-bold mb-4">Password Reset Successful</h1>

      <div class="bg-green-50 border border-green-200 p-4 rounded mb-6">
        <p class="text-green-700 font-medium mb-4">Your temporary password has been generated:</p>
        <div class="bg-white border-2 border-green-300 p-4 rounded font-mono text-lg font-bold text-center text-gray-900 mb-4">
          <%= tempPassword %>
        </div>
        <p class="text-green-700 text-sm mb-4">
          <strong>Important:</strong> Write down this password or copy it. You'll need it to log in.
        </p>
      </div>

      <div class="space-y-4">
        <div class="p-4 bg-blue-50 border border-blue-200 rounded text-sm text-blue-800">
          <p class="font-semibold mb-2">Next steps:</p>
          <ol class="list-decimal pl-5 space-y-1">
            <li>Click "Log In" below</li>
            <li>Enter your username and the temporary password above</li>
            <li>After logging in, go to your profile to set a new permanent password</li>
          </ol>
        </div>

        <div class="pt-4">
          <a href="/auth/login" class="block text-center bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 font-medium">Log In with Temporary Password</a>
        </div>
      </div>
    </div>
  </main>

  <%- include("partials/footer") %>
