<%- include("partials/header", { title: "Forgot Password" }) %>

<main id="main-content" class="container mx-auto px-6 py-12 flex-1 max-w-md">
  <h1 class="text-2xl font-bold mb-4">Reset Your Password</h1>

  <p class="text-gray-600 mb-6 text-sm">Enter your username to receive instructions for resetting your password.</p>

  <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
    <div class="bg-red-50 border border-red-200 p-3 mb-4" role="alert">
      <ul class="list-disc pl-5 text-red-700 text-sm">
        <% errors.forEach(function(err) { %>
          <li><%= err.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    <div class="bg-green-50 border border-green-200 p-3 mb-4 rounded" role="alert">
      <p class="text-green-700 font-medium text-sm"><%= successMessage %></p>
    </div>
  <% } %>

  <form method="POST" action="/auth/forgot-password" class="space-y-4" novalidate>
    <label class="block">
      <span class="text-sm font-medium">Username</span>
      <input id="username" name="username" type="text" class="mt-1 block w-full rounded border border-gray-300 px-3 py-2 shadow-sm" value="<%= data && data.username ? data.username : '' %>" required>
    </label>

    <div>
      <button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 text-sm font-medium">Send Reset Instructions</button>
      <a href="/auth/login" class="ml-3 text-sm text-gray-700 hover:underline">Back to Login</a>
    </div>
  </form>

  <div class="mt-6 p-4 bg-blue-50 border border-blue-200 rounded text-sm text-blue-800">
    <p class="font-semibold mb-2">How it works:</p>
    <ol class="list-decimal pl-5 space-y-1">
      <li>Enter your username</li>
      <li>A new temporary password will be generated</li>
      <li>You'll be shown the password to login with</li>
        <li>Change your password in your profile settings</li>
      </ol>
    </div>
  </main>

<%- include("partials/footer") %>
