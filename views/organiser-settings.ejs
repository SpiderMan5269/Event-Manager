<%- include("partials/header", { title: "Site Settings" }) %>

<main id="main-content" class="container mx-auto px-6 py-12 flex-1">
  <div class="max-w-2xl mx-auto">
    <h1 class="text-4xl font-bold mb-2 text-gray-900">Site Settings</h1>
    <p class="text-gray-600 mb-8">Manage your event management platform settings</p>

    <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-8" role="alert">
        <h3 class="font-semibold text-red-800 mb-2">Please correct the following errors:</h3>
        <ul class="list-disc pl-5 text-red-700 space-y-1">
          <% errors.forEach(function(err) { %>
            <li><%= err.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <div class="bg-white rounded-lg shadow-md p-8 border border-gray-200">
      <form method="POST" action="/organiser/settings" class="space-y-6" novalidate>
        <div>
          <label for="site_name" class="block text-lg font-medium text-gray-900 mb-2">Site Name</label>
          <input 
            id="site_name" 
            name="name" 
            type="text" 
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" 
            value="<%= settings && settings.name ? settings.name : '' %>" 
            placeholder="Enter your site name"
            aria-describedby="<%= (typeof fieldErrors !== 'undefined' && fieldErrors.name) ? 'site_name_error' : '' %>">
          <% if (typeof fieldErrors !== 'undefined' && fieldErrors && fieldErrors.name) { %>
            <small id="site_name_error" class="text-red-600 text-sm mt-1 block"><%= fieldErrors.name[0] %></small>
          <% } %>
        </div>

        <div>
          <label for="site_description" class="block text-lg font-medium text-gray-900 mb-2">Description</label>
          <textarea 
            id="site_description" 
            name="description" 
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" 
            rows="4"
            placeholder="Enter a description for your site"
            aria-describedby="<%= (typeof fieldErrors !== 'undefined' && fieldErrors.description) ? 'site_description_error' : '' %>"><%= settings && settings.description ? settings.description : '' %></textarea>
          <% if (typeof fieldErrors !== 'undefined' && fieldErrors && fieldErrors.description) { %>
            <small id="site_description_error" class="text-red-600 text-sm mt-1 block"><%= fieldErrors.description[0] %></small>
          <% } %>
        </div>

        <div>
          <label for="site_email" class="block text-lg font-medium text-gray-900 mb-2">Contact Email <span class="text-gray-500 text-sm">(Optional)</span></label>
          <input 
            id="site_email" 
            name="email" 
            type="email" 
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" 
            value="<%= settings && settings.email ? settings.email : '' %>" 
            placeholder="contact@example.com">
        </div>

        <div>
          <label for="site_contact" class="block text-lg font-medium text-gray-900 mb-2">Contact Information <span class="text-gray-500 text-sm">(Optional)</span></label>
          <textarea 
            id="site_contact" 
            name="contact_info" 
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" 
            rows="3"
            placeholder="Phone, address, or other contact details"><%= settings && settings.contact_info ? settings.contact_info : '' %></textarea>
        </div>


        <div class="flex gap-4 pt-4">
          <button type="submit" class="bg-indigo-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-indigo-700 transition">Save Changes</button>
          <a href="/organiser" class="bg-gray-200 text-gray-800 px-6 py-3 rounded-lg font-semibold hover:bg-gray-300 transition">Back to Home</a>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include("partials/footer") %>
