<%- include("partials/header", { title: "Organiser Home" }) %>

<main id="main-content" class="container mx-auto px-6 py-12 flex-1">
  <div class="mb-8">
    <a href="/" class="text-indigo-600 hover:text-indigo-700 font-medium flex items-center">← Back to Home</a>
  </div>

  <div class="mb-10">
    <h1 class="text-4xl font-bold text-gray-900 mb-2">Organiser Dashboard</h1>
    <p class="text-gray-600">Manage your events and track performance</p>
  </div>

  <!-- Site Info Card -->
  <div class="bg-gradient-to-r from-indigo-50 to-blue-50 rounded-lg shadow-md p-8 mb-10 border border-indigo-200">
    <h2 class="text-2xl font-bold text-gray-900 mb-2"><%= site.name %></h2>
    <p class="text-gray-700 mb-4"><%= site.description %></p>
    <div class="flex gap-4 flex-wrap">
      <a href="/organiser/settings" class="bg-indigo-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-indigo-700 transition">Site Settings</a>
      <a href="/organiser/analytics" class="bg-blue-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-blue-700 transition">Analytics Dashboard</a>
    </div>
  </div>

  <!-- Create Event Button -->
  <div class="mb-10">
    <form method="POST" action="/organiser/events/create">
      <button type="submit" class="bg-green-600 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-green-700 transition shadow-md">+ Create New Event</button>
    </form>
  </div>

  <!-- Draft Events Section -->
  <section class="mb-12">
    <h3 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
      <span class="bg-yellow-100 text-yellow-800 rounded-full w-8 h-8 flex items-center justify-center text-sm font-semibold mr-3"><%= draftEvents.length %></span>
      Draft Events
    </h3>
    <% if (draftEvents.length === 0) { %>
      <div class="text-gray-600 text-center py-8">
        <p class="mb-4">No draft events.</p>
        <form method="POST" action="/organiser/events/create" style="display:inline">
          <button type="submit" class="text-indigo-600 hover:text-indigo-700 font-bold underline">Create one</button>
        </form>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% draftEvents.forEach(event => { %>
          <div class="bg-white rounded-lg shadow-md border-l-4 border-yellow-500 p-6 hover:shadow-lg transition">
            <div class="mb-4">
              <span class="inline-block bg-yellow-100 text-yellow-800 text-xs font-semibold px-3 py-1 rounded-full mb-2">DRAFT</span>
              <h4 class="text-xl font-bold text-gray-900"><%= event.title || "Untitled Event" %></h4>
            </div>
            <div class="space-y-3">
              <p class="text-sm text-gray-500">Last modified: <%= event.lastModifiedDisplay %></p>
              <div class="flex gap-2 flex-wrap">
                <a href="/organiser/events/<%= event.id %>/view" class="bg-blue-100 text-blue-700 px-4 py-2 rounded font-semibold hover:bg-blue-200 transition text-sm">View</a>
                <a href="/organiser/events/<%= event.id %>/edit" class="bg-indigo-100 text-indigo-700 px-4 py-2 rounded font-semibold hover:bg-indigo-200 transition text-sm">Edit</a>
                <form method="POST" action="/organiser/events/<%= event.id %>/publish" style="display:inline">
                  <button type="submit" class="bg-green-100 text-green-700 px-4 py-2 rounded font-semibold hover:bg-green-200 transition text-sm">Publish</button>
                </form>
                <form method="POST" action="/organiser/events/<%= event.id %>/delete" style="display:inline">
                  <button type="submit" class="bg-red-100 text-red-700 px-4 py-2 rounded font-semibold hover:bg-red-200 transition text-sm">Delete</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <!-- Published Events Section -->
  <section>
    <h3 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
      <span class="bg-green-100 text-green-800 rounded-full w-8 h-8 flex items-center justify-center text-sm font-semibold mr-3"><%= publishedEvents.length %></span>
      Published Events
    </h3>
    <% if (publishedEvents.length === 0) { %>
      <div class="text-gray-600 text-center py-8">
        <p class="mb-4">No published events.</p>
        <form method="POST" action="/organiser/events/create" style="display:inline">
          <button type="submit" class="text-indigo-600 hover:text-indigo-700 font-bold underline">Create and publish one</button>
        </form>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% publishedEvents.forEach(event => { %>
          <div class="bg-white rounded-lg shadow-md border-l-4 border-green-500 p-6 hover:shadow-lg transition">
            <div class="mb-4">
              <span class="inline-block bg-green-100 text-green-800 text-xs font-semibold px-3 py-1 rounded-full mb-2">PUBLISHED</span>
              <h4 class="text-xl font-bold text-gray-900"><%= event.title %></h4>
            </div>
            <div class="space-y-3">
              <p class="text-sm text-gray-500">Last modified: <%= event.lastModifiedDisplay %></p>
              <div class="flex gap-2 flex-wrap">
                <a href="/organiser/events/<%= event.id %>/view" class="bg-blue-100 text-blue-700 px-4 py-2 rounded font-semibold hover:bg-blue-200 transition text-sm">View</a>
                <form method="POST" action="/organiser/events/<%= event.id %>/delete" style="display:inline">
                  <button type="submit" class="bg-red-100 text-red-700 px-4 py-2 rounded font-semibold hover:bg-red-200 transition text-sm">Delete</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>
</main>

<%- include("partials/footer") %>
