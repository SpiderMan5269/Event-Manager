<%- include("partials/header", { title: "Attendee Home" }) %>

<main id="main-content" class="container mx-auto px-6 py-12 flex-1">
  <div class="mb-8">
    <a href="/" class="text-indigo-600 hover:text-indigo-700 font-medium flex items-center">← Back to Home</a>
  </div>

  <header class="mb-10">
    <h1 class="text-4xl font-bold text-gray-900 mb-2"><%= site.name %></h1>
    <p class="text-lg text-gray-600"><%= site.description %></p>
  </header>

  <section>
    <h2 class="text-3xl font-bold text-gray-900 mb-8">Discover Events</h2>
    
    <!-- Search and Filter Form -->
    <form method="GET" action="/attendee" class="mb-8">
      <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
          <div>
            <label for="search" class="block text-sm font-medium text-gray-700 mb-1">Search</label>
            <input 
              id="search"
              type="text" 
              name="search" 
              placeholder="Event name or description..." 
              value="<%= searchTerm %>"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
          </div>

          <div>
            <label for="minPrice" class="block text-sm font-medium text-gray-700 mb-1">Min Price (£)</label>
            <input 
              id="minPrice"
              type="number" 
              name="minPrice" 
              placeholder="0" 
              min="0"
              step="0.01"
              value="<%= minPrice || '' %>"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
          </div>

          <div>
            <label for="maxPrice" class="block text-sm font-medium text-gray-700 mb-1">Max Price (£)</label>
            <input 
              id="maxPrice"
              type="number" 
              name="maxPrice" 
              placeholder="999" 
              min="0"
              step="0.01"
              value="<%= maxPrice || '' %>"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
          </div>

          <div>
            <label for="availability" class="block text-sm font-medium text-gray-700 mb-1">Availability</label>
            <select 
              id="availability"
              name="availability" 
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
              <option value="">All Events</option>
              <option value="available" <% if (availability === 'available') { %>selected<% } %>>Available</option>
              <option value="soldout" <% if (availability === 'soldout') { %>selected<% } %>>Sold Out</option>
            </select>
          </div>
        </div>

        <div class="flex gap-3 flex-wrap">
          <button type="submit" class="bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 font-semibold transition">Search & Filter</button>
          <a href="/attendee" class="bg-gray-300 text-gray-800 px-6 py-2 rounded-lg hover:bg-gray-400 font-semibold transition">Clear All</a>
        </div>
      </div>
    </form>

    <% if (searchTerm || minPrice || maxPrice || availability) { %>
      <p class="text-lg text-gray-600 mb-6">
        <strong>Active filters:</strong>
        <% if (searchTerm) { %>Search: "<%= searchTerm %>"<% } %>
        <% if (minPrice) { %>Min Price: £<%= minPrice %><% } %>
        <% if (maxPrice) { %>Max Price: £<%= maxPrice %><% } %>
        <% if (availability) { %>Availability: <%= availability %><% } %>
      </p>
    <% } %>

    <% if (!events || events.length === 0) { %>
      <div class="bg-blue-50 rounded-lg p-8 text-center border border-blue-200">
        <% if (searchTerm || minPrice || maxPrice || availability) { %>
          <p class="text-gray-600 text-lg">No events match your filters. <a href="/attendee" class="text-indigo-600 hover:underline font-semibold">Clear filters</a></p>
        <% } else { %>
          <p class="text-gray-600 text-lg">No events available at the moment. Check back soon!</p>
        <% } %>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% events.forEach(event => { %>
          <div class="bg-white rounded-lg shadow-md overflow-hidden border border-gray-200 hover:shadow-xl transition h-full flex flex-col">
            <div class="relative overflow-hidden bg-gradient-to-br from-indigo-100 to-blue-100" style="aspect-ratio: 16/9; display: flex; align-items: center; justify-content: center;">
              <span class="text-gray-400 text-3xl">🎟️</span>
            </div>

            <div class="p-6 flex flex-col flex-grow">
              <a href="/attendee/events/<%= event.id %>" class="text-indigo-600 hover:text-indigo-700 group">
                <h3 class="text-xl font-bold mb-2 text-gray-900 group-hover:underline"><%= event.title %></h3>
              </a>
              <p class="text-gray-700 mb-3 flex-grow text-sm leading-relaxed line-clamp-3"><%= event.description %></p>
              <p class="text-sm text-gray-600 mb-4 font-medium">📅 <%= event.event_date %></p>
              
              <div class="flex items-center justify-between pt-4 border-t border-gray-200">
                <a href="/attendee/events/<%= event.id %>" class="text-indigo-600 hover:text-indigo-700 font-bold text-sm">View Details →</a>
                <% if (event.isSoldOut) { %>
                  <span class="inline-block bg-red-100 text-red-700 px-3 py-1 rounded-full text-xs font-bold">Sold Out</span>
                <% } else { %>
                  <span class="inline-block bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-bold">Available</span>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>
</main>

<%- include("partials/footer") %>
