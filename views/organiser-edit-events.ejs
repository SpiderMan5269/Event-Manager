<%- include("partials/header", { title: "Edit Event" }) %>

<main id="main-content" class="container mx-auto px-6 py-12 flex-1">
  <div class="max-w-2xl mx-auto">
    <h1 class="text-4xl font-bold mb-2">Edit Event</h1>
    <p class="text-sm text-gray-500">Created at: <%= event.created_at %></p>
    <p class="text-sm text-gray-500 mb-6">Last modified: <%= event.lastModifiedDisplay %></p>

    <% if (errors && errors.length > 0) { %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6" role="alert">
        <h3 class="font-semibold text-red-800 mb-2">Please correct the following errors:</h3>
        <ul class="list-disc pl-5 text-red-700 space-y-1">
          <% errors.forEach(err => { %>
            <li><%= err.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <div class="bg-white rounded-lg shadow-md p-8 border border-gray-200">
      <form method="POST" action="/organiser/events/<%= event.id %>/edit" class="space-y-6" novalidate>
        <div>
          <label for="title" class="block text-lg font-medium text-gray-900 mb-2">Event Title</label>
          <input 
            id="title" 
            name="title" 
            type="text" 
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
            value="<%= (typeof data !== 'undefined' && data && data.title) ? data.title : event.title %>" 
            aria-describedby="<%= (typeof fieldErrors !== 'undefined' && fieldErrors.title) ? 'title_error' : '' %>">
          <% if (typeof fieldErrors !== 'undefined' && fieldErrors && fieldErrors.title) { %>
            <small id="title_error" class="text-red-600 text-sm mt-1 block"><%= fieldErrors.title[0] %></small>
          <% } %>
        </div>

        <div>
          <label for="description" class="block text-lg font-medium text-gray-900 mb-2">Description</label>
          <textarea 
            id="description" 
            name="description" 
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
            rows="5"><%= (typeof data !== 'undefined' && data && data.description) ? data.description : event.description %></textarea>
          <% if (typeof fieldErrors !== 'undefined' && fieldErrors && fieldErrors.description) { %>
            <small id="description_error" class="text-red-600 text-sm mt-1 block"><%= fieldErrors.description[0] %></small>
          <% } %>
        </div>

        <div>
          <label for="event_date" class="block text-lg font-medium text-gray-900 mb-2">Event Date</label>
          <input 
            id="event_date" 
            name="event_date" 
            type="date" 
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
            value="<%= (typeof data !== 'undefined' && data && data.event_date) ? data.event_date : event.event_date %>" 
            min="<%= new Date().toISOString().split('T')[0] %>" 
            aria-describedby="<%= (typeof fieldErrors !== 'undefined' && fieldErrors.event_date) ? 'event_date_error' : '' %>">
          <% if (typeof fieldErrors !== 'undefined' && fieldErrors && fieldErrors.event_date) { %>
            <small id="event_date_error" class="text-red-600 text-sm mt-1 block"><%= fieldErrors.event_date[0] %></small>
          <% } %>
        </div>

        <div class="border-t pt-8">
          <h3 class="text-2xl font-bold text-gray-900 mb-6">Ticket Pricing</h3>

          <% tickets.forEach(ticket => { %>
            <div class="bg-gray-50 p-6 rounded-lg border border-gray-200 mb-6">
              <div class="font-bold text-xl capitalize mb-4 text-gray-900"><%= ticket.type %> Ticket</div>
              <div class="grid grid-cols-2 gap-6">
                <label class="block">
                  <span class="block text-lg font-medium text-gray-900 mb-2">Price (£)</span>
                  <input 
                    type="number" 
                    name="<%= ticket.type %>_price" 
                    step="0.01" 
                    min="0" 
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                    value="<%= (typeof data !== 'undefined' && data && data[(ticket.type + '_price')]) ? data[(ticket.type + '_price')] : ticket.price %>" 
                    placeholder="0.00">
                </label>
                <label class="block">
                  <span class="block text-lg font-medium text-gray-900 mb-2">Quantity Available</span>
                  <input 
                    type="number" 
                    name="<%= ticket.type %>_quantity" 
                    min="0" 
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                    value="<%= (typeof data !== 'undefined' && data && data[(ticket.type + '_quantity')]) ? data[(ticket.type + '_quantity')] : ticket.total_quantity %>" 
                    placeholder="0">
                </label>
              </div>
            </div>
          <% }) %>
        </div>

        <div class="flex gap-4 pt-4">
          <button type="submit" class="bg-indigo-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-indigo-700 transition">Save Changes</button>
          <a href="/organiser" class="bg-gray-200 text-gray-800 px-6 py-3 rounded-lg font-semibold hover:bg-gray-300 transition">Back to Home</a>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include("partials/footer") %>
