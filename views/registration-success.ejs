<%- include("partials/header", { title: "Registration Successful" }) %>

<main id="main-content" class="container mx-auto px-6 py-12 flex-1">
  <div class="max-w-md mx-auto">
    <div class="bg-gradient-to-b from-green-50 to-green-100 border-2 border-green-300 rounded-lg p-8 text-center shadow-lg">
      <div class="text-5xl mb-4">✅</div>
      
      <h1 class="text-3xl font-bold text-green-800 mb-2">Welcome!</h1>
      
      <p class="text-lg text-green-700 mb-6">
        Hello <span class="font-semibold"><%= req.session.user.user_name %></span>,
      </p>
      
      <p class="text-green-600 mb-8">
        Your account has been successfully created and you are now logged in. You're all set to start exploring events!
      </p>
      
      <div class="space-y-3">
        <a href="/" class="block w-full bg-green-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-green-700 transition shadow-md">
          Go to Home Page
        </a>
        
        <a href="/attendee" class="block w-full bg-indigo-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-indigo-700 transition shadow-md">
          Browse Events
        </a>
      </div>
      
      <p class="text-sm text-gray-600 mt-6">
        <a href="/profile" class="text-indigo-600 hover:underline">View your profile</a> or <a href="/auth/logout" class="text-indigo-600 hover:underline">logout</a>
      </p>
    </div>
  </div>
</main>

<%- include("partials/footer") %>
